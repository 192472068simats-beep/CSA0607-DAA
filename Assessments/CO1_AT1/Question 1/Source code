"""ShopSphere scalability audit: verifies every result in the worked solution.

Run:  python shopsphere_audit.py
"""
import math

OPS_PER_SEC = 1e8
WINDOW_SEC = 10 * 60                      # 10-minute nightly window
BUDGET = OPS_PER_SEC * WINDOW_SEC         # 6e10 operations


# ---------- (b) M1: duplicate-listing detector ----------
def m1_count(n):
    """Count comparisons of the nested loop by actually running it."""
    count = 0
    for i in range(0, n - 1):
        for j in range(i + 1, n):
            count += 1
    return count


def m1_formula(n):
    return n * (n - 1) // 2


# ---------- (b) M2: API rate limiter ----------
def m2_count(n):
    """Count Audit() calls by simulating the doubling loop."""
    count, i = 0, 1
    while i < n:
        for _ in range(i):
            count += 1
        i *= 2
    return count


def m2_formula(n):
    return 2 ** math.ceil(math.log2(n)) - 1


# ---------- (c) S2: binary search and its recurrence ----------
def binary_search(arr, key):
    """Iterative binary search. Returns (index, comparisons). Space: O(1)."""
    lo, hi, comps = 0, len(arr) - 1, 0
    while lo <= hi:
        mid = (lo + hi) // 2
        comps += 1
        if arr[mid] == key:
            return mid, comps
        if arr[mid] < key:
            lo = mid + 1
        else:
            hi = mid - 1
    return -1, comps


def binary_search_rec(arr, key, lo, hi, depth=1):
    """Recursive binary search. Returns (index, comparisons). Stack: O(log n)."""
    if lo > hi:
        return -1, depth - 1
    mid = (lo + hi) // 2
    if arr[mid] == key:
        return mid, depth
    if arr[mid] < key:
        return binary_search_rec(arr, key, mid + 1, hi, depth + 1)
    return binary_search_rec(arr, key, lo, mid - 1, depth + 1)


def t_s2(n):
    """T(n) = T(n/2) + 1, T(1) = 1  (integer halving)."""
    return 1 if n <= 1 else t_s2(n // 2) + 1


# ---------- (d) Master theorem helper ----------
def master(a, b, d):
    """For T(n) = aT(n/b) + Theta(n^d). Returns the result as text."""
    crit = math.log(a, b)
    if math.isclose(d, crit):
        return f"Case 2: Theta(n^{d:g} log n)"
    if d < crit:
        return f"Case 1: Theta(n^{crit:g})"
    return f"Case 3: Theta(n^{d:g})"


def solve_recurrence(a, b, f, n):
    """Exact value of T(n) = aT(n/b) + f(n), T(1) = 1, for n a power of b."""
    return 1 if n <= 1 else a * solve_recurrence(a, b, f, n // b) + f(n)


# ---------- (e) S1 average case ----------
def s1_average(n, p):
    return p * (n + 1) / 2 + (1 - p) * n


# ---------- (f) Theta(n^2) bound check ----------
def f_report(n):
    return 3 * n ** 2 + 10 * n * math.log2(n) + 50 if n > 0 else 50


def check_theta(c1=3, c2=63, n0=1, upto=100000):
    return all(c1 * n * n <= f_report(n) <= c2 * n * n for n in range(n0, upto))


# ---------- (g) Scalability table ----------
def fmt_time(sec):
    if sec < 1e-3:
        return f"{sec * 1e6:.2f} us"
    if sec < 1:
        return f"{sec * 1e3:.2f} ms"
    if sec < 3600:
        return f"{sec:,.1f} s ({sec / 60:,.1f} min)"
    return f"{sec:,.0f} s ({sec / 3600:,.1f} h)"


def main():
    print("== (b) M1 and M2: simulation vs formula ==")
    for n in (10, 100, 1000):
        assert m1_count(n) == m1_formula(n)
    print("M1 simulated count equals n(n-1)/2 for n = 10, 100, 1000")
    for n in (8, 100, 1024, 5000):
        assert m2_count(n) == m2_formula(n)
    print(f"M2 simulated count equals 2^ceil(log2 n) - 1; n=1024 -> {m2_count(1024)}"
          f" (n log n would be {1024 * 10})")

    print("\n== (c) S2: recurrence and worst-case comparisons ==")
    for n in (1, 2, 8, 1024, 10 ** 6):
        print(f"T({n}) = {t_s2(n)}   floor(log2 n) + 1 = {int(math.log2(n)) + 1}")
    arr = list(range(1_000_000))
    _, c_iter = binary_search(arr, 999_999)
    _, c_rec = binary_search_rec(arr, 999_999, 0, len(arr) - 1)
    print(f"Search near the end of 10^6 items: iterative {c_iter}, recursive {c_rec} comparisons")

    print("\n== (d) Master theorem ==")
    print("M4 current  T(n)=4T(n/2)+n :", master(4, 2, 1))
    print("M4 redesign T(n)=2T(n/2)+n :", master(2, 2, 1))
    for k in (10, 14, 18):
        n = 2 ** k
        cur = solve_recurrence(4, 2, lambda m: m, n)
        new = solve_recurrence(2, 2, lambda m: m, n)
        print(f"n=2^{k}: current={cur:,} (2n^2-n={2 * n * n - n:,})  "
              f"redesign={new:,} (n log n + n={n * k + n:,})")
    print("M5: no standard case applies; extended theorem gives Theta(n log^2 n)")
    for k in (10, 14, 18):
        n = 2 ** k
        t = solve_recurrence(2, 2, lambda m: m * math.log2(m), n)
        print(f"n=2^{k}: T/(n log^2 n) = {t / (n * k * k):.3f}   (tends to 0.5)")

    print("\n== (e) S1 average ==")
    print(f"n=10^6, p=0.5 -> {s1_average(10 ** 6, 0.5):,.2f} comparisons")

    print("\n== (f) f(n) = 3n^2 + 10 n log2 n + 50 ==")
    print("3n^2 <= f(n) <= 63n^2 for 1 <= n < 100000:", check_theta())
    for n in (10, 1000, 10 ** 6):
        print(f"n={n:>8}: f(n)/n = {f_report(n) / n:,.1f}  (grows without bound, so f is not O(n))")

    print("\n== (g) Scalability at n = 10^6 ==")
    n = 10 ** 6
    lg = math.log2(n)
    rows = [
        ("M1", n * (n - 1) / 2),
        ("M2", 2 ** math.ceil(math.log2(n)) - 1),
        ("S2", math.floor(lg) + 1),
        ("M4 current (2n^2-n)", 2 * n * n - n),
        ("M4 redesign (n log n)", n * lg),
        ("M5 (n log n (log n+1)/2)", n * lg * (lg + 1) / 2),
        ("Report f(n)", f_report(n)),
    ]
    print(f"Budget: {BUDGET:.0e} operations in {WINDOW_SEC} s")
    print(f"{'Module':<28}{'Operations':>16}   {'Time':<26}Fits?")
    for name, ops in rows:
        sec = ops / OPS_PER_SEC
        print(f"{name:<28}{ops:>16.3e}   {fmt_time(sec):<26}{'yes' if ops <= BUDGET else 'NO'}")


if __name__ == "__main__":
    main()
